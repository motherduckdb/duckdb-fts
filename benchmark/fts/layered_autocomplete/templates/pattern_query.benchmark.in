name ${display_name}
group fts
subgroup pattern-query

require fts

init
CREATE TABLE documents(id VARCHAR NOT NULL, title VARCHAR, body VARCHAR);
INSERT INTO documents
SELECT 'doc' || lpad(i::VARCHAR, 12, '0') AS id,
       'record category' || (i % 100)::VARCHAR || ' region' || (i % 20)::VARCHAR AS title,
       'workspace item search benchmark ' ||
           CASE i % 20
               WHEN 0 THEN 'northstar prefixalpha patternmarker'
               WHEN 1 THEN 'northstar prefixbeta patternmarker'
               WHEN 2 THEN 'southstar infixalpha patternmarker'
               WHEN 3 THEN 'eaststar prefixgamma patternmarker'
               WHEN 4 THEN 'weststar infixbeta patternmarker'
               ELSE 'baseline catalog archive'
           END || ' ' || substr(md5(i::VARCHAR), 1, 16) AS body
FROM range(${rows}) AS source(i);

load
PRAGMA create_fts_index('documents', 'id', 'title', 'body', stemmer='porter', stopwords='none', layered_search=true, incremental=true);

assert I
SELECT count(*)
FROM (
    SELECT gram, rawtermid
    FROM fts_main_documents.raw_term_grams
    GROUP BY gram, rawtermid
    HAVING count(*) > 1
)
----
0

assert I
SELECT (count(*) > 0) = ${expect_hits}
FROM fts_main_documents.search_layered_bm25(
    '${query_string}',
    fields := 'body',
    top_k := 50,
    query_mode := '${query_mode}'
)
----
true

run
SELECT docname, score, rank
FROM fts_main_documents.search_layered_bm25(
    '${query_string}',
    fields := 'body',
    top_k := 50,
    query_mode := '${query_mode}'
);
